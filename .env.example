# Gideon Configuration
# Copy this file to .env and modify it to customize your settings

# =============================================================================
# LLM Configuration
# =============================================================================

# Default LLM provider: ollama, openai, anthropic, docker-model
DEFAULT_LLM_SERVICE_TYPE=openai

# Model selection (depends on provider):
# - Ollama: deepseek-r1:latest, llama2, codellama, mistral, etc.
# - OpenAI: gpt-4-turbo-preview, gpt-4, gpt-3.5-turbo
# - Anthropic: claude-3-5-sonnet-20241022, claude-3-opus, claude-3-sonnet
DEFAULT_LLM_MODEL=gpt-4-turbo-preview

# Temperature for LLM responses (0.0 = deterministic, 1.0 = creative)
DEFAULT_LLM_TEMPERATURE=0.1

# =============================================================================
# API Keys (Required for cloud providers)
# =============================================================================

# OpenAI API Key (get it from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API Key (get it from https://console.anthropic.com/)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# =============================================================================
# File Processing
# =============================================================================

# Maximum content length to process (in characters)
MAX_CONTENT_LENGTH=500000

# Maximum number of PDF pages to extract
MAX_PDF_PAGES=5

# Supported file extensions (currently only PDF)
SUPPORTED_EXTENSIONS=[".pdf"]
